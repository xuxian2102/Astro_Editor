{
  "version": 1,
  "contentDir": "src/content/blog",
  "extensions": [".md"],
  "frontmatter": {
    "fields": [
      { "name": "title", "type": "string", "required": true },
      { "name": "pubDate", "type": "date", "required": true },
      { "name": "draft", "type": "boolean", "default": false },
      { "name": "tags", "type": "tags" }
    ]
  },
  "preview": {
    "command": "node_modules/.bin/astro",
    "args": ["dev"],
    "host": "127.0.0.1",
    "port": 4321,
    "routeTemplate": "/blog/{slug}"
  },
  "assets": {
    "mode": "colocated"
  }
}

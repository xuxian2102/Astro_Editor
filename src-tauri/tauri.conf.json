{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "blog-editor",
  "version": "0.1.1",
  "identifier": "dev.xuxian.blogeditor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blog Editor",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "base-uri": ["'none'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"],
        "img-src": ["'self'", "blob:", "data:", "http:", "https:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "base-uri": ["'none'"],
        "connect-src": ["ipc:", "http://ipc.localhost", "ws://localhost:5173"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"],
        "img-src": ["'self'", "blob:", "data:", "http:", "https:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}

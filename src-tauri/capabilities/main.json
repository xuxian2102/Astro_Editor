{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "受信主窗口：授予全部应用命令。preview 窗口（后续阶段加入）不得出现在这里。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-select-project",
    "allow-get-project",
    "allow-update-project-config",
    "allow-list-posts",
    "allow-read-post",
    "allow-write-post",
    "allow-create-post",
    "allow-rename-post",
    "allow-delete-post",
    "allow-list-tags",
    "allow-save-image",
    "allow-read-image-asset",
    "allow-import-clipboard-images",
    "allow-discard-pending-images",
    "allow-write-draft",
    "allow-read-draft",
    "allow-delete-draft",
    "allow-git-status",
    "allow-git-publish",
    "allow-ensure-preview-server",
    "allow-stop-preview-server",
    "allow-get-preview-status",
    "opener:allow-open-url"
  ]
}
